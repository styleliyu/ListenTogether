# Copy to /opt/listentogether/server.env on the server. Never commit the real file.
CORS_ORIGIN=https://podcast.still-fantasy.com
DATABASE_PROVIDER=postgres
# Keep PostgreSQL bound to the host loopback interface. The container uses this Unix socket.
DATABASE_URL=postgresql://allcanlisten:CHANGE_ME@localhost/allcanlisten?host=/var/run/postgresql

ROOM_CLOCK_INTERVAL_MS=30000
ROOM_CLEANUP_INTERVAL_MS=60000
VISITOR_OFFLINE_TIMEOUT_MS=1800000
ROOM_IDLE_PAUSE_TIMEOUT_MS=0
TEMP_ROOM_DELETE_AFTER_EMPTY_MS=3600000

XIMALAYA_APP_KEY=
XIMALAYA_APP_SECRET=
XIMALAYA_CLIENT_OS_TYPE=4
XIMALAYA_SERVER_API_VERSION=1.0.0
XIMALAYA_DEVICE_ID=
XIMALAYA_DEVICE_ID_TYPE=
XIMALAYA_SIG_MODE=md5_secret_concat

QQ_MUSIC_COOKIE=

NETEASE_OPENAPI_ENABLED=false
NETEASE_OPENAPI_BASE_URL=https://openncm.music.163.com
NETEASE_OPENAPI_TIMEOUT_MS=8000
NETEASE_OPENAPI_APP_ID=
NETEASE_OPENAPI_APP_SECRET=
NETEASE_OPENAPI_PUBLIC_KEY=
# Keep a PEM key on one line by replacing newlines with literal \n sequences.
NETEASE_OPENAPI_PRIVATE_KEY=
NETEASE_OPENAPI_DEVICE_ID=
