FROM node:22-bookworm-slim AS build

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@8.15.9 --activate

COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY tsconfig.json tsconfig.node.json vite.config.ts index.html ./
COPY public ./public
COPY src ./src

ARG VITE_API_URL
ARG VITE_WEBSOCKET_URL
ARG VITE_HEARTBEAT_PERIOD=15

RUN test -n "$VITE_API_URL" \
    && test -n "$VITE_WEBSOCKET_URL" \
    && VITE_API_URL="$VITE_API_URL" \
       VITE_WEBSOCKET_URL="$VITE_WEBSOCKET_URL" \
       VITE_HEARTBEAT_PERIOD="$VITE_HEARTBEAT_PERIOD" \
       pnpm build

FROM nginx:1.28-alpine AS runtime

LABEL org.opencontainers.image.source="https://github.com/styleliyu/ListenTogether"
LABEL org.opencontainers.image.description="ListenTogether React web application"

COPY docker/web-nginx.conf /etc/nginx/nginx.conf
COPY --from=build /app/dist /usr/share/nginx/html

USER nginx

EXPOSE 8080

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=4 \
  CMD wget -qO- http://127.0.0.1:8080/healthz >/dev/null || exit 1

CMD ["nginx", "-g", "daemon off;"]
