{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "strict": true,
    "jsx": "react-jsx",
    "sourceMap": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@decrypt-core/*": ["src/decrypt-core/*"]
    },
    "lib": ["ESNext", "DOM"],
    "skipLibCheck": true,
    "types": [
      "react",
      "react-dom",
      "./node_modules/user-agent-data-types"
    ]
  },
  "include": ["src/main.tsx", "src/App.tsx", "src/router/**/*.tsx", "src/pages/**/*.tsx", "src/components/**/*.tsx", "src/hooks/useAudioPlayer.ts", "src/hooks/useHeartbeat.ts", "src/hooks/useRoomPage.ts", "src/hooks/useRoomWebSocket.ts", "src/hooks/useTheme.ts", "src/stores/**/*.ts", "src/services/**/*.ts", "src/types/**/*.ts", "src/utils/**/*.ts", "src/request/**/*.ts", "src/vite-env.d.ts"],
  "exclude": ["src/decrypt-core/**/__test__/**", "src/**/*.vue"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
