{
  "name": "podcast-together",
  "version": "0.9.4",
  "packageManager": "pnpm@8.15.9",
  "description": "一个基于 Vite + React + TypeScript 的全栈项目，让你跟好友一起实时同步听音乐、播客和本地音频。",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev-force": "vite --force",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "npx http-server -P http://127.0.0.1:${PORT} ./dist"
  },
  "engines": {
    "node": ">=18 <25"
  },
  "dependencies": {
    "browser-id3-writer": "^4.4.0",
    "buffer": "^6.0.3",
    "crypto-js": "^4.1.1",
    "iconv-lite": "^0.6.3",
    "jimp": "0.16.1",
    "metaflac-js": "^1.0.5",
    "music-metadata-browser": "2.2.7",
    "nanoid": "^4.0.2",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.23.1",
    "shikwasa2": "^2.3.0",
    "threads": "^1.6.5",
    "vconsole": "^3.15.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/node": "^18.16.16",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.3.1",
    "sass": "^1.66.1",
    "typescript": "^5.0.4",
    "user-agent-data-types": "^0.3.1",
    "vite": "^4.4.9",
    "vite-plugin-pwa": "^0.16.4"
  },
  "author": "yenche123 <tsuiyenche@outlook.com> (https://github.com/yenche123)",
  "contributors": [],
  "keywords": [
    "music",
    "音乐",
    "podcast",
    "播客",
    "react",
    "web-socket",
    "shikwasa",
    "typescript",
    "一起听",
    "实时连线"
  ],
  "license": "MIT",
  "repository": "github:yenche123/podcast-together"
}
